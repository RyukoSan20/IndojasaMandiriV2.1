    "symbol": "TLKM.JK",
    "profit_loss_percent": -2.3
  },
  "sector_allocation": [
    {"sector": "Financial", "percentage": 45, "value": 24525000},
    {"sector": "Technology", "percentage": 25, "value": 13625000},
    {"sector": "Consumer", "percentage": 30, "value": 16350000}
  ]
}


